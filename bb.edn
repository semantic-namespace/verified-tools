;; bb check   meta-source over the vocabulary, the modules and their code
;; bb build   the artifact: what the router may serve, and why the rest is out
;; bb serve   the router, an MCP server over stdio, serving the artifact
;; bb confirm  the user answering what the router asks, in their own terminal
;; bb auth     grants a credential the installed tools declare (OAuth, your own client)
;; bb add      installs a module pinned by SHA, after showing what it may do
;; bb remove   removes one, after showing what goes with it
;; bb diff     what changes between two artifacts
;; bb claude   starts Claude Code under a profile's policy: bb claude --profile finance [--dry-run]
;; bb test     the checks, the build, the router, the sandbox and the egress, end to end
{:paths ["router/src" "sdk/src" "dev"]
 :deps {io.github.semantic-namespace/meta-source {:git/url "https://github.com/semantic-namespace/meta-source"
                                                  :git/sha "24cfd78374cdd98c8d8e9b498f3f983a82390eff"}}
 :tasks {check {:doc "meta-source check over vocab/ and modules/: bb check [--fail-on error]"
                :requires ([meta-source.cli :as cli])
                :task (apply cli/-main "check" "--brief" *command-line-args*)}
         build {:doc "Builds artifact/artifact.edn from what meta-source reads and checks: bb build [replay|live]"
                :requires ([verified.build :as build])
                :task (apply build/-main *command-line-args*)}
         serve {:doc "The router: an MCP server over stdio serving the artifact's tools"
                :requires ([verified.router :as router])
                :task (apply router/-main *command-line-args*)}
         confirm {:doc "What the router is waiting to ask, and the answer: bb confirm [<id> yes|no]"
                  :requires ([verified.confirm :as confirm])
                  :task (apply confirm/-main *command-line-args*)}
         auth {:doc "Grants a credential for exactly the scopes the installed tools declare: bb auth google [--no-browser]"
               :requires ([verified.oauth :as oauth])
               :task (apply oauth/-main *command-line-args*)}
         add {:doc "Installs a module after showing what it may do: bb add <git-url> <sha> [--path p] [--yes|--dry-run]"
              :requires ([verified.install :as install])
              :task (apply install/add-main *command-line-args*)}
         remove {:doc "Removes an installed module after showing what goes: bb remove <module-dir> [--yes]"
                 :requires ([verified.install :as install])
                 :task (apply install/remove-main *command-line-args*)}
         diff {:doc "What changes between two artifacts: bb diff old.edn new.edn"
               :requires ([verified.diff :as diff])
               :task (apply diff/-main *command-line-args*)}
         claude {:doc "Starts Claude Code under a profile's policy: bb claude --profile <name> [--folder dir] [--dry-run] [-- claude args]"
                 :requires ([verified.launcher :as launcher])
                 :task (apply launcher/-main *command-line-args*)}
         policy-hook {:doc "The verified-tools policy as a Claude Code PreToolUse hook (stdin: the hook's JSON)"
                      :requires ([verified.hook :as hook])
                      :task (apply hook/-main *command-line-args*)}
         test {:doc "Runs test/: bb test [namespace-suffix ...]"
               :extra-paths ["test"]
               :requires ([verified.test-runner :as tr])
               :task (apply tr/-main *command-line-args*)}
         fake-provider {:doc "A stand-in for Gmail and the paste service, for the live path: bb fake-provider [port]"
                        :requires ([fake-provider :as fp])
                        :task (apply fp/-main *command-line-args*)}}}
